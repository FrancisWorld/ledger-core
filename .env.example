# Copy to .env for docker compose. All values are placeholders: change both passwords.
# Password of the schema owner (runs migrations, issues API keys).
LEDGER_OWNER_DB_PASSWORD=replace-me
# Password of the unprivileged ledger_app role the service connects as.
LEDGER_APP_DB_PASSWORD=replace-me-too
LEDGER_HTTP_PORT=8080
LEDGER_DB_PORT=5432
